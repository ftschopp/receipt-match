    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@date-fns/tz": "^1.5.0",
    "@ftschopp/dynatable-core": "^2.4.0",
    "@middy/core": "^7.9.2",
    "@middy/http-header-normalizer": "^7.9.2",
    "@middy/http-json-body-parser": "^7.9.2",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "jimp": "^1.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "serverless": "3.40.0",
    "serverless-esbuild": "^1.57.2",
    "serverless-offline": "^13.10.2",
