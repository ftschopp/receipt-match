{
  "name": "@receipt-match/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "serverless offline start --stage local",
    "deploy": "serverless deploy --stage dev",
