{
  "name": "receipt-match",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "local:up": "docker compose up -d",
    "local:setup": "npm run local:setup -w @receipt-match/api",
    "dev:api": "npm run dev -w @receipt-match/api",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @receipt-match/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @receipt-match/web",
    "demo-receipts": "npm run demo-receipts -w @receipt-match/api",
    "record-fixtures": "npm run record-fixtures -w @receipt-match/api --",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
